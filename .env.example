# ==========================================
# AEGIS-48: ORACLE ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# SUPABASE (For Audit Caching & Report Storage)
# Get keys at: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-never-expose"

# ------------------------------------------
# AI ORACLE (For Smart Contract Vulnerability Auditing)
# ------------------------------------------
# OpenAI API Key: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Anthropic API Key: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY="sk-ant-..."

# ------------------------------------------
# BLOCKCHAIN RPC ENDPOINTS (To fetch source code & bytecode)
# ------------------------------------------

# EVM Chains (Ethereum, Arbitrum, Base, Polygon)
# Get Alchemy Key at: https://dashboard.alchemy.com/
ALCHEMY_API_KEY="your-alchemy-key"
ETH_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}"
BASE_RPC_URL="https://base-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}"
ARB_RPC_URL="https://arb-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}"
POLYGON_RPC_URL="https://polygon-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}"

# Solana (SVM)
# Get Helius Key at: https://dev.helius.xyz/dashboard/app
HELIUS_API_KEY="your-helius-key"
SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}"

# Aptos (Move)
# Public Endpoint (Or get dedicated at: https://developer.aptoslabs.com/)
APTOS_RPC_URL="https://fullnode.mainnet.aptoslabs.com/v1"

# ------------------------------------------
# BLOCK EXPLORER APIs (For fetching verified source code)
# ------------------------------------------
# Get Etherscan Key: https://etherscan.io/myapikey
ETHERSCAN_API_KEY="your-etherscan-api-key"
# Get Basescan Key: https://basescan.org/myapikey
BASESCAN_API_KEY="your-basescan-api-key"
# Get Arbiscan Key: https://arbiscan.io/myapikey
ARBISCAN_API_KEY="your-arbiscan-api-key"
# Get Polygonscan Key: https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY="your-polygonscan-api-key"
